# ShopAssist-AI – credentials checklist (PLACEHOLDERS ONLY)
# Copy to .env for your own notes. .env is git-ignored. Never commit real keys.
# In n8n Cloud you do NOT read this file: you paste each value into
# n8n -> Credentials -> Add credential (name shown in brackets).

# --- OpenAI  [OpenAI account] ---------------------------------------------
OPENAI_API_KEY=sk-REPLACE_ME
# Models used: gpt-4o-mini (chat), text-embedding-3-small (1536 dims)

# --- Pinecone  [Pinecone account] -----------------------------------------
PINECONE_API_KEY=pcsk_REPLACE_ME
PINECONE_INDEX=shopassist          # dimension 1536, metric cosine

# --- Supabase Postgres  [Supabase Postgres] -------------------------------
# Supabase -> Project Settings -> Database -> Connection pooler (Session mode)
POSTGRES_HOST=aws-0-ap-south-1.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres.REPLACE_ME_PROJECT_REF
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_SSL=require

# --- Twilio  [Twilio account] ---------------------------------------------
TWILIO_ACCOUNT_SID=ACREPLACE_ME
TWILIO_AUTH_TOKEN=REPLACE_ME
TWILIO_FROM_NUMBER=+10000000000    # your Twilio number (paste into the Twilio nodes)
TWILIO_TEST_TO_NUMBER=+91XXXXXXXXXX # a VERIFIED number (trial accounts only send to verified numbers)

# --- Slack  [Slack account] -----------------------------------------------
# Slack app with bot scopes: chat:write, channels:read  -> Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-REPLACE_ME
SLACK_CHANNEL=#support-escalations

# --- Gmail SMTP  [Gmail SMTP] ---------------------------------------------
# Needs 2-Step Verification + an App Password (Google Account -> Security -> App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=your.gmail@gmail.com
SMTP_APP_PASSWORD=REPLACE_ME_16_CHARS
SUPPORT_EMAIL=support@urbanthread.example   # where escalation e-mails go (use your own inbox)

# --- n8n -----------------------------------------------------------------
N8N_BASE_URL=https://YOUR-NAME.app.n8n.cloud
