# ShopAssist-AI – credentials checklist (PLACEHOLDERS ONLY)
# Copy to .env for your own notes. .env is git-ignored. Never commit real keys.
# n8n does NOT read this file: the scripts in scripts/ do (import, Pinecone setup, checks, web app).
# scripts/import_to_n8n.py creates the Postgres and Pinecone credentials in n8n from these values.

# --- Ollama (local AI, no key)  [Ollama account] --------------------------
# Install from https://ollama.com, open the app, then:  ollama pull qwen2.5:3b  &&  ollama pull nomic-embed-text
# The n8n credential is created by scripts/import_to_n8n.py. If n8n runs in Docker use http://host.docker.internal:11434
OLLAMA_URL=http://localhost:11434
# Models used: qwen2.5:3b (chat), nomic-embed-text (embeddings, 768 dims)

# --- Pinecone  [Pinecone account] -----------------------------------------
PINECONE_API_KEY=pcsk_REPLACE_ME
PINECONE_INDEX=shopassist          # dimension 768, metric cosine (scripts/setup_pinecone.py creates it)

# --- Supabase Postgres  [Supabase Postgres] -------------------------------
# Supabase -> Connect -> Session pooler. Copy host and user EXACTLY (the region in the host differs per project)
POSTGRES_HOST=aws-REPLACE_ME.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres.REPLACE_ME_PROJECT_REF
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_SSL=require

# --- Twilio  [Twilio account] ---------------------------------------------
TWILIO_ACCOUNT_SID=ACREPLACE_ME
TWILIO_AUTH_TOKEN=REPLACE_ME
TWILIO_FROM_NUMBER=+10000000000    # your Twilio number (paste into the Twilio nodes)
TWILIO_TEST_TO_NUMBER=+91XXXXXXXXXX # a VERIFIED number (trial accounts only send to verified numbers)

# --- Slack  [Slack account] -----------------------------------------------
# Slack app with bot scopes: chat:write, channels:read  -> Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-REPLACE_ME
SLACK_CHANNEL=#support-escalations

# --- Gmail SMTP  [Gmail SMTP] ---------------------------------------------
# Needs 2-Step Verification + an App Password (Google Account -> Security -> App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=your.gmail@gmail.com
SMTP_APP_PASSWORD=REPLACE_ME_16_CHARS
SUPPORT_EMAIL=support@urbanthread.example   # where escalation e-mails go (use your own inbox)

# --- n8n -----------------------------------------------------------------
# Local n8n on your Mac. API key: n8n -> Settings -> n8n API -> Create an API key
N8N_URL=http://localhost:5679
N8N_API_KEY=REPLACE_ME
# Address of n8n as a browser sees it, for the purchase-order approval links in Slack (tunnel / cloud URL).
# Leave empty to use N8N_URL.
N8N_PUBLIC_URL=

# --- Web app (app/server.py) -----------------------------------------------
# Protects the manager dashboard when the app is reachable from the internet (tunnel / cloud).
# Make one with:  python3 -c "import secrets; print(secrets.token_urlsafe(16))"
ADMIN_KEY=

# --- Docker Compose (scripts/up.sh) ------------------------------------------
# With docker compose, Postgres runs locally instead of Supabase. Use these POSTGRES_* values instead of the
# Supabase ones above:  POSTGRES_HOST=localhost  POSTGRES_PORT=5433  POSTGRES_USER=postgres
#                       POSTGRES_PASSWORD=shopassist  POSTGRES_SSL=disable
# n8n inside Docker reaches that database as "postgres:5432":
# POSTGRES_HOST_FOR_N8N=postgres
# POSTGRES_PORT_FOR_N8N=5432

# --- Cloud version (no laptop needed): Groq + Cohere, free keys ---------------
# python3 scripts/import_to_n8n.py --cloud --publish  creates the n8n credentials from these.
# Groq: console.groq.com -> API Keys (free).  Cohere: dashboard.cohere.com -> API keys (free trial key).
# Cloud n8n on Render (bash scripts/cloud_setup.sh uses these; the local N8N_URL / N8N_API_KEY above stay as they are)
CLOUD_N8N_URL=https://shopassist-n8n.onrender.com
CLOUD_N8N_API_KEY=REPLACE_ME
GROQ_API_KEY=REPLACE_ME
COHERE_API_KEY=REPLACE_ME
# Evaluation judge: with GROQ_API_KEY set, scripts/evaluate.py uses llama-3.3-70b-versatile as the judge.
# JUDGE_PROVIDER=ollama
# JUDGE_MODEL=qwen2.5:7b
